<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker ka preview (API 31+): Alerts 2x2 jaisa (Ujla), likhai "—". Sirf RemoteViews wale view. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_l_lav"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <!-- header: ghanti + Alerts -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_ic_bell"
            android:tint="#FF17161D" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="@string/widget_pv_alerts_title"
            android:textColor="#FF17161D"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <include layout="@layout/widget_preview_alert_row" />

    <include layout="@layout/widget_preview_alert_row" />

    <include layout="@layout/widget_preview_alert_row" />
</LinearLayout>
