<resources>
    <style name="Theme.MfcDash" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.MfcDash.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/icon_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_mfc_fg</item>
        <item name="postSplashScreenTheme">@style/Theme.MfcDash</item>
    </style>
</resources>
